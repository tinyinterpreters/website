---
import { getCollection } from "astro:content";
const posts = await getCollection("posts");
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=1" />

    <title>Tiny Interpreters</title>
  </head>
  <body>
    <header>
      <h1>Tiny Interpreters</h1>
      <h2>Hand-crafted, byte-sized interpreters with Elm</h2>
    </header>
    <hr>
    <h2>Posts</h2>
    {posts.length === 0
      ? <p>No posts.</p>
      : <ul>
          {posts.map(post => (
            <li><a href={`/posts/${post.id}`}>{post.data.title}</a></li>
          ))}
        </ul>
    }

  </body>
</html>
